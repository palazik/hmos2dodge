# Additive HarmonyOS support, preserving Android GKI/vendor options.
CONFIG_ACCESS_TOKENID=y
CONFIG_DEVTMPFS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EROFS_FS=y
# Keep the stock controller set: enabling pids changes cgroup structure ABI.
# CONFIG_CGROUP_PIDS is not set
# User preference for every subsequent kernel build.
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_THIN is not set
# CONFIG_LTO_CLANG_FULL is not set
