; SPDX-License-Identifier: Apache-2.0
; Diskless guest observer only. Never include in a phone/DSU policy.
; Let the init-domain observer execute the donor loader and map hilog without
; transitioning into the donor's disabled production debug-client domain.
(allow init system_lib_file (file (execute_no_trans)))
(allow init hilog_exec (file (read open getattr execute map)))
(allow init hilog_output_socket (sock_file (write)))
(allow init hilogd (unix_stream_socket (connectto)))
; RAM backing-file permissions live in op13-ramdata.cil, shared with the
; native bootstrap. This supplement contains only guest diagnostics.
; Production init has no reason to query this SA. Grant only the guest
; observer this lookup; the access-token service's own add/get already exist.
(allow init sa_accesstoken_manager_service (samgr_class (get)))
; Account-manager query in the expanded framework lab, observer only.
(allow init sa_accountmgr (samgr_class (get)))
; Selected Foundation queries by the observer only.
(allow init sa_foundation_bms (samgr_class (get)))
(allow init sa_foundation_cesfwk_service (samgr_class (get)))
(allow init sa_huks_service (samgr_class (get)))
(allow init sa_installd_service (samgr_class (get)))
; Capture the first appspawn fault PC in the diskless guest. Do not change
; appspawn's own permissions or disable its seccomp/signal handlers.
(allow init appspawn (process (ptrace getattr)))
(allow init self (capability (sys_ptrace)))
